# Database Configuration
DATABASE_URL=postgresql://postgres:secretpassword@postgres:5432/mangodefend_database

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Message Queue
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Object Storage (AWS S3 / MinIO / Supabase S3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_RAW=raw-uploads
S3_BUCKET_QUARANTINE=quarantine-files
S3_REGION=us-east-1

# Security & JWT
SECRET_KEY=change_this_to_a_random_secure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_MERCHANT_ID=G123456789